{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "azuredatafactory-mandeep"
		},
		"ADLS_LinkedServer_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ADLS_LinkedServer'"
		},
		"AzureSQL_LinkedServer_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSQL_LinkedServer'"
		},
		"ADLS_LinkedServer_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://mandeepstorageaccount.dfs.core.windows.net/"
		},
		"AzureSQL_LinkedServer_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azuresql-server-mandeep.database.windows.net"
		},
		"AzureSQL_LinkedServer_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AzureSQL_Mandeep"
		},
		"AzureSQL_LinkedServer_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "mandeep3458"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/ADLS_LinkedServer')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('ADLS_LinkedServer_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('ADLS_LinkedServer_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzureSQL_LinkedServer')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('AzureSQL_LinkedServer_properties_typeProperties_server')]",
					"database": "[parameters('AzureSQL_LinkedServer_properties_typeProperties_database')]",
					"encrypt": "optional",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('AzureSQL_LinkedServer_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('AzureSQL_LinkedServer_password')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}