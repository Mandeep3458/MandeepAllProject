{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "azuredatafactory-mandeep"
		},
		"ADLS_LinkedServer_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ADLS_LinkedServer'"
		},
		"AzureSQL_LinkedServer_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSQL_LinkedServer'"
		},
		"ADLS_LinkedServer_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://mandeepstorageaccount.dfs.core.windows.net/"
		},
		"AzureSQL_LinkedServer_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azuresql-server-mandeep.database.windows.net"
		},
		"AzureSQL_LinkedServer_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AzureSQL_Mandeep"
		},
		"AzureSQL_LinkedServer_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "mandeep3458"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "azuredatafactory-mandeep_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ADLS_LinkedServer_accountKey": {
						"value": "[parameters('ADLS_LinkedServer_accountKey')]"
					},
					"AzureSQL_LinkedServer_password": {
						"value": "[parameters('AzureSQL_LinkedServer_password')]"
					},
					"ADLS_LinkedServer_properties_typeProperties_url": {
						"value": "[parameters('ADLS_LinkedServer_properties_typeProperties_url')]"
					},
					"AzureSQL_LinkedServer_properties_typeProperties_server": {
						"value": "[parameters('AzureSQL_LinkedServer_properties_typeProperties_server')]"
					},
					"AzureSQL_LinkedServer_properties_typeProperties_database": {
						"value": "[parameters('AzureSQL_LinkedServer_properties_typeProperties_database')]"
					},
					"AzureSQL_LinkedServer_properties_typeProperties_userName": {
						"value": "[parameters('AzureSQL_LinkedServer_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}